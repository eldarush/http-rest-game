<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>API Schemas — HTTP & REST Game</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <section class="card">
      <h2>Resource Schemas & Field Definitions</h2>
      <p class="subtitle">System entities and contracts exposed under <code>/api</code>.</p>

      <% schemas.forEach(schema => { %>
        <article class="schema-block" style="margin-top: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <h3><%= schema.name %></h3>
            <span class="badge badge-endpoint"><%= schema.endpoint %></span>
          </div>
          <p class="subtitle" style="margin-bottom: 0.5rem;"><%= schema.description %></p>
          <table class="table">
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Type</th>
                <th>Required</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <% schema.fields.forEach(field => { %>
                <tr>
                  <td><code><%= field.name %></code></td>
                  <td><span class="type-pill"><%= field.type %></span></td>
                  <td><%= field.required ? 'Yes' : 'No' %></td>
                  <td><%= field.description %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>
