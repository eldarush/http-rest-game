<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>REST Quest — HTTP Learning Game</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <!-- Stage Header & Progress -->
    <section class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
          <span class="badge badge-endpoint" id="stage-badge">Stage 1</span>
          <h2 id="stage-title" style="margin-top: 0.5rem;">Loading Challenge...</h2>
        </div>
        <div style="text-align: right;">
          <label for="stage-select" style="font-size: 0.85rem; color: var(--muted);">Jump to:</label>
          <select id="stage-select" class="select-method" style="margin-left: 0.5rem;"></select>
          <div style="font-size: 0.85rem; color: var(--muted); margin-top: 0.3rem;">Attempts: <span id="attempts-count">0</span></div>
        </div>
      </div>
      <p id="stage-description" class="subtitle"></p>
      <div id="stage-feedback" style="display: none; padding: 0.75rem; border-radius: 6px; margin-top: 0.5rem; font-weight: 600;"></div>
    </section>

    <!-- Request Builder Form -->
    <section class="card">
      <h3>HTTP Request Builder</h3>
      <p class="subtitle">Assemble the HTTP method, resource path, query parameters, and JSON payload.</p>

      <form id="request-form">
        <div class="form-row">
          <select id="http-method" class="select-method">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PUT">PUT</option>
            <option value="DELETE">DELETE</option>
          </select>
          <input type="text" id="request-path" class="input-path" placeholder="/api/products" value="/api/products">
          <button type="submit" id="send-btn" class="btn btn-primary">Send Request</button>
        </div>

        <div id="body-container" style="display: none; margin-top: 1rem;">
          <label style="font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 0.3rem;">Request Body (JSON):</label>
          <textarea id="request-body" class="textarea-body" placeholder='{ "name": "...", "price": 0 }'></textarea>
        </div>
      </form>
    </section>

    <!-- Response Inspector -->
    <section class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h3>Server Response</h3>
        <span id="status-badge" class="badge" style="display: none;"></span>
      </div>
      <div id="response-output" class="response-box">Press "Send Request" to execute the HTTP call.</div>
    </section>
  </main>

  <script src="/js/game.js"></script>
</body>
</html>
