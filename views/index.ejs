<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>REST Quest — HTTP Learning Game</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <!-- Stage Header & Progress -->
    <section class="card">
      <div class="stage-header">
        <div>
          <span class="badge badge-endpoint" id="stage-badge">Stage 1</span>
          <h2 id="stage-title" class="stage-title">Loading Challenge...</h2>
        </div>
        <div class="stage-meta">
          <label for="stage-select" class="jump-label">Jump to:</label>
          <select id="stage-select" class="select-method jump-select"></select>
          <div class="attempts">Attempts: <span id="attempts-count">0</span></div>
        </div>
      </div>
      <p id="stage-description" class="subtitle"></p>
      <div id="stage-feedback" class="feedback" hidden></div>
    </section>

    <!-- Request Builder Form -->
    <section class="card">
      <h3>HTTP Request Builder</h3>
      <p class="subtitle">Assemble the HTTP method, resource path, query parameters, and JSON payload.</p>

      <form id="request-form">
        <div class="form-row">
          <select id="http-method" class="select-method">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PUT">PUT</option>
            <option value="DELETE">DELETE</option>
          </select>
          <input type="text" id="request-path" class="input-path" placeholder="/api/products" value="/api/products">
          <button type="submit" id="send-btn" class="btn btn-primary">Send Request</button>
        </div>

        <div id="body-container" class="body-field" hidden>
          <label class="field-label">Request Body (JSON):</label>
          <textarea id="request-body" class="textarea-body" placeholder='{ "name": "...", "price": 0 }'></textarea>
        </div>
      </form>
    </section>

    <!-- Response Inspector -->
    <section class="card">
      <div class="response-header">
        <h3>Server Response</h3>
        <span id="status-badge" class="badge" hidden></span>
      </div>
      <div id="response-output" class="response-box">Press "Send Request" to execute the HTTP call.</div>
    </section>
  </main>

  <script src="/js/game.js"></script>
</body>
</html>
